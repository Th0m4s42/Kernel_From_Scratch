CC      := i686-elf-gcc
AS      := nasm

SRC     := src
INC     := inc
BUILD   := build
KERNEL  := iso/boot/myos.bin
ISO     := myos.iso

#=====================================================================================
#	FLAGS
#=====================================================================================

CFLAGS  := -std=gnu99 -ffreestanding -O2 -Wall -Wextra \
		   -fno-builtin -fno-exceptions -fno-stack-protector -fno-rtti -nostdlib -nodefaultlibs \
		   -I$(INC) -MMD -MP
ASFLAGS := -f elf32
LDFLAGS := -T linker.ld -ffreestanding -O2 -nostdlib

#=====================================================================================
#	SOURCES
#=====================================================================================

C_SRCS   :=	$(SRC)/kernel.c \
			$(SRC)/keyboard.c \
			$(SRC)/pic.c \
			$(SRC)/gdt.c \
			$(SRC)/idt.c \
			$(SRC)/terminal.c \

ASM_SRCS :=	$(SRC)/boot.asm \
			$(SRC)/interrupts.asm \

# src/gdt.c -> build/gdt.c.o   |   src/boot.asm -> build/boot.asm.o
C_OBJS   := $(C_SRCS:$(SRC)/%.c=$(BUILD)/%.c.o)
ASM_OBJS := $(ASM_SRCS:$(SRC)/%.asm=$(BUILD)/%.asm.o)
OBJS     := $(ASM_OBJS) $(C_OBJS)

DEPS     := $(C_OBJS:.o=.d)

#=====================================================================================
#	RULES
#=====================================================================================

iso: $(ISO)

$(ISO): $(KERNEL) iso/boot/grub/grub.cfg
	grub-mkrescue -o $@ iso

$(KERNEL): $(OBJS) linker.ld
	mkdir -p $(@D)
	$(CC) $(LDFLAGS) -o $@ $(OBJS) -lgcc

$(BUILD)/%.asm.o: $(SRC)/%.asm | $(BUILD)
	$(AS) $(ASFLAGS) $< -o $@

$(BUILD)/%.c.o: $(SRC)/%.c | $(BUILD)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD):
	mkdir -p $@

clean:
	rm -rf $(BUILD) $(ISO) $(KERNEL)

re: clean iso

-include $(DEPS)

.PHONY: iso clean re